# =============================================================================
# Required — demo will not start without these
# =============================================================================

# HandCash Connect app (https://dashboard.handcash.io)
HANDCASH_APP_ID=
HANDCASH_APP_SECRET=

# Handle or paymail that receives the demo payment ($0.05 USD in code)
DEMO_RECEIVER_HANDLE=your_app_handle

# At least 32 characters each (enforced at startup). Generate: openssl rand -base64 32
MPP_RECEIPT_SECRET=change-me-receipt-secret-min-32-chars-please
MPP_SERVER_SECRET=change-me-server-secret-min-32-chars-please

# =============================================================================
# Optional — sensible defaults exist
# =============================================================================

# Where HandCash Cloud POSTs /webhooks/payment. Defaults to http://localhost:3456
# (webhooks will not reach your laptop until you set this to a public URL, e.g. ngrok).
PUBLIC_BASE_URL=http://localhost:3456

# After hosted HandCash Pay, browser redirect (default: {PUBLIC_BASE_URL}/mpp/return).
# PAY_REDIRECT_URL=https://your-tunnel.example.com/mpp/return

# After Connect authorization, popup lands here (default: {PUBLIC_BASE_URL}/connect/callback).
# Must match the Connect app “authorization success” URL in the HandCash dashboard.
# CONNECT_CALLBACK_URL=https://your-tunnel.example.com/connect/callback

# HTTP port (default 3456)
PORT=3456

# =============================================================================
# Local-only: simulate webhook when Cloud cannot reach PUBLIC_BASE_URL
# =============================================================================

# Header x-demo-complete-secret for POST /demo/complete — use 32+ random chars if you enable the route.
DEMO_COMPLETE_SECRET=demo-complete-local-secret-min-32-chars-ok

# NODE_ENV=production disables POST /demo/complete unless ALLOW_DEMO_COMPLETE=1 (discouraged).
# NODE_ENV=development
# ALLOW_DEMO_COMPLETE=0
