# HandCash Connect app (https://dashboard.handcash.io)
HANDCASH_APP_ID=
HANDCASH_APP_SECRET=

# Handle or paymail that receives the demo payment (your app payout destination)
DEMO_RECEIVER_HANDLE=your_app_handle

# Random long strings for production; any values for local demo
MPP_RECEIPT_SECRET=change-me-receipt-secret-min-32-chars-please
MPP_SERVER_SECRET=change-me-server-secret-min-32-chars-please

# Base URL where HandCash Cloud can POST webhooks (ngrok, Cloudflare Tunnel, deployed host).
# For laptop-only demos leave empty and use POST /demo/complete instead.
PUBLIC_BASE_URL=http://localhost:3456

# Optional. After HandCash Pay, users are sent here (default: {PUBLIC_BASE_URL}/mpp/return).
# Must match what your Connect app allows for payment-request redirects when HandCash enforces allowlists.
# PAY_REDIRECT_URL=https://your-tunnel.example.com/mpp/return

# Optional. After HandCash Connect authorization, the demo opens this URL in a popup (default: {PUBLIC_BASE_URL}/connect/callback).
# Must match “Authorization success URL” (or equivalent) in the HandCash Developer Dashboard for this app.
# CONNECT_CALLBACK_URL=https://your-tunnel.example.com/connect/callback

# Optional: protect local “simulate paid” shortcut (recommended if PUBLIC_BASE_URL is empty)
DEMO_COMPLETE_SECRET=demo-local-only-secret

# Server port
PORT=3456
